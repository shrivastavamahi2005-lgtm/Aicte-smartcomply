# AICTE SmartComply AI - Backend Production & Local Configuration

PROJECT_NAME="AICTE SmartComply AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./smartcomply.db"
# Hosted PostgreSQL in production (Supabase, Neon, Render, Railway, AWS RDS):
# DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-1.aws.neon.tech/smartcomply?sslmode=require"

# Security & Cryptographic JWT Configuration
# Generate a secure 32+ character key for production (e.g. openssl rand -hex 32)
SECRET_KEY="generate_a_secure_random_production_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
# Set to "*" for all origins or a comma-separated list of allowed frontend domains:
# E.g.: "https://aicte-smartcomply-ai.vercel.app,http://localhost:5173"
BACKEND_CORS_ORIGINS="*"

# AI Provider Configuration (Provider-independent RAG copilot abstraction)
# AI_PROVIDER can be "mock" (offline rule-based expert engine), "gemini", "openai", or "ollama"
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-pro"

# Persistent File Storage
UPLOAD_DIR="./uploads"

# SMTP Notifications (Optional)
SMTP_ENABLED=false
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="alerts@smartcomply.aicte.gov.in"
